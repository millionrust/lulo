{
  "title": "Calendar: Settings ▸ Advanced turns on week numbers and off year-view events",
  "app": "calendar",
  "launch": {},
  "lulo_only": true,
  "steps": [
    {"key": "cmd-,", "settle": 1.0},
    {"select": "Advanced", "settle": 0.6},
    {"observe": "defaults", "facts": ["settings_controls"]},
    {"select": "Show week numbers", "settle": 0.5},
    {"select": "Show events in year view", "settle": 0.5},
    {"observe": "toggled", "facts": ["settings_controls"]}
  ]
}
