[Unit]
Description=rmac secure session locker
Documentation=https://github.com/rmac/rmac
BindsTo=graphical-session.target
After=graphical-session.target
OnFailure=rmac-lock-fallback.service
StartLimitIntervalSec=30s
StartLimitBurst=5
# Assert, never Condition: a failed Condition skips the unit while
# `systemctl start` still exits 0, so a lock request (and the pre-sleep lock
# that holds suspend) would report success with nothing locked. A failed
# Assert fails the start job and runs OnFailure.
AssertPathExists=/etc/pam.d/rmac-lock

[Service]
Type=notify
NotifyAccess=all
ExecStart=%h/.local/libexec/rmac/rmac-lock-provider
TimeoutStartSec=15s
WatchdogSec=10s
WatchdogSignal=SIGKILL
Restart=on-failure
RestartSec=1s
KillMode=control-group
# Release builds abort on panic, and a core of this process can hold the
# typed password (libpam's copy and the input buffer).
LimitCORE=0
