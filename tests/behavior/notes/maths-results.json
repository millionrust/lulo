{
  "title": "Notes: Insert Results appends the answer after an expression's equals sign",
  "app": "notes",
  "launch": {},
  "lulo_only": true,
  "steps": [
    {"wait": 2},
    {"key": "cmd-n", "settle": 1},
    {"type": "Maths note"},
    {"key": "tab"},
    {"menu_action": "notes::MathsResultsInsert", "settle": 0.5},
    {"type": "12+30="},
    {"observe": "inserted", "facts": ["note_body"]}
  ]
}
