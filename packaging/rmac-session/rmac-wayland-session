#!/bin/sh
set -u

session_pid=
rmac_started=false
rmac_config_imported=false
safe_mode=false
manager_environment=

stop_rmac()
{
    if [ "${rmac_started}" = true ]; then
        /usr/bin/systemctl --user stop \
            rmac-session.target rmac-safe-mode.target \
            rmac-idle-lock.service rmac-lock-coordinator.service \
            rmac-session-supervisor.service >/dev/null 2>&1 || :
        rmac_started=false
    fi
    if [ "${rmac_config_imported}" = true ]; then
        /usr/bin/systemctl --user unset-environment NIRI_CONFIG \
            >/dev/null 2>&1 || :
        rmac_config_imported=false
    fi
    /usr/bin/systemctl --user unset-environment RMAC_COLOR_SCHEME \
        >/dev/null 2>&1 || :
}

terminate_session()
{
    signal=$1
    status=$2
    trap - HUP INT TERM
    if [ -n "${session_pid}" ] && kill -0 "${session_pid}" 2>/dev/null; then
        kill -"${signal}" "${session_pid}" 2>/dev/null || :
        wait "${session_pid}" 2>/dev/null || :
    fi
    stop_rmac
    exit "${status}"
}

trap 'terminate_session HUP 129' HUP
trap 'terminate_session INT 130' INT
trap 'terminate_session TERM 143' TERM

if [ ! -x /usr/bin/niri-session ]; then
    echo "rmac requires the packaged niri session launcher" >&2
    exit 1
fi
if [ ! -x /usr/libexec/rmac/rmac-session-start ]; then
    echo "rmac session integration is incomplete" >&2
    exit 1
fi

state_home=${XDG_STATE_HOME:-"${HOME}/.local/state"}
safe_mode_marker=${state_home}/rmac/session/safe-mode.json
supervisor=/usr/libexec/rmac/rmac-session-supervisor
desktop_units="niri.service rmac-session.target rmac-safe-mode.target"

# One systemd user manager serves every login of this user. A desktop left
# running by an earlier login (a session that is closing, or one left behind
# on another VT) makes niri-session refuse to start, which looks like a login
# loop from the greeter. Stop that leftover desktop; refuse, with a reason,
# only when another graphical login is still in the foreground of a seat.
stop_leftover_desktop()
{
    # shellcheck disable=SC2086
    if ! /usr/bin/systemctl --user --quiet is-active ${desktop_units}; then
        return 0
    fi
    sessions=$(/usr/bin/loginctl show-user "$(/usr/bin/id -u)" \
        --property=Sessions --value 2>/dev/null) || sessions=
    for other in ${sessions}; do
        case ${other} in
            ''|*[!A-Za-z0-9]*) continue ;;
        esac
        [ "${other}" != "${XDG_SESSION_ID-}" ] || continue
        other_type=$(/usr/bin/loginctl show-session "${other}" \
            --property=Type --value 2>/dev/null) || continue
        case ${other_type} in
            wayland|x11) ;;
            *) continue ;;
        esac
        other_state=$(/usr/bin/loginctl show-session "${other}" \
            --property=State --value 2>/dev/null) || continue
        if [ "${other_state}" = active ]; then
            other_seat=$(/usr/bin/loginctl show-session "${other}" \
                --property=Seat --value 2>/dev/null) || other_seat=
            echo "rmac cannot start: you are still logged in to another desktop" \
                "(session ${other}${other_seat:+ on ${other_seat}})." \
                "Log out of it, then log in again." >&2
            return 1
        fi
    done
    echo "rmac is stopping a desktop left running by an earlier login" >&2
    # shellcheck disable=SC2086
    /usr/bin/systemctl --user stop --no-block \
        rmac-session.target rmac-safe-mode.target \
        rmac-idle-lock.service rmac-lock-coordinator.service \
        rmac-session-supervisor.service niri.service >/dev/null 2>&1 || :
    attempt=0
    while [ "${attempt}" -lt 100 ]; do
        # shellcheck disable=SC2086
        if ! /usr/bin/systemctl --user --quiet is-active ${desktop_units}; then
            /usr/bin/systemctl --user reset-failed niri.service \
                >/dev/null 2>&1 || :
            return 0
        fi
        /usr/bin/sleep 0.1
        attempt=$((attempt + 1))
    done
    echo "rmac cannot start: the desktop left by an earlier login did not stop" >&2
    return 1
}

if ! stop_leftover_desktop; then
    exit 1
fi

# Safe mode lasts one login, like a Mac's. The supervisor consumes the marker
# (keeping it as safe-mode.last.json) and skips it outright when the failing
# component has been rebuilt since. When the supervisor itself cannot run,
# still consume the marker here so a broken build cannot trap every login.
login_mode=
if [ -x "${supervisor}" ]; then
    login_mode=$("${supervisor}" begin-login) || login_mode=
fi
case ${login_mode} in
    normal|safe) ;;
    *)
        login_mode=normal
        if [ -e "${safe_mode_marker}" ] || [ -L "${safe_mode_marker}" ]; then
            login_mode=safe
            if ! /usr/bin/mv -f "${safe_mode_marker}" \
                "${state_home}/rmac/session/safe-mode.last.json"; then
                echo "rmac could not clear safe mode for the next login" >&2
            fi
        fi
        ;;
esac

# The rmac login has its own user-writable niri authority. Its small entry
# point includes package-owned shell policy, so upgrades can improve the
# desktop without replacing display/input choices saved by System Settings.
prepare_rmac_config()
{
    config_home=${XDG_CONFIG_HOME:-"${HOME}/.config"}
    case ${config_home} in
        /*) ;;
        *)
            echo "the rmac config home must be an absolute path" >&2
            return 1
            ;;
    esac
    packaged_config=/usr/share/rmac/niri/config.kdl
    rmac_config=${config_home}/rmac/niri/config.kdl
    rmac_shortcuts=${config_home}/rmac/niri/shortcuts-generated.kdl
    rmac_session_config=${config_home}/rmac/niri/session.kdl
    if [ ! -f "${packaged_config}" ] || [ -L "${packaged_config}" ]; then
        echo "the packaged rmac niri configuration is unavailable" >&2
        return 1
    fi
    /usr/bin/install -d -m 0700 "${config_home}/rmac/niri" || return 1
    if [ ! -e "${rmac_config}" ]; then
        /usr/bin/install -m 0600 "${packaged_config}" "${rmac_config}" || return 1
    fi
    if [ ! -f "${rmac_config}" ] || [ -L "${rmac_config}" ]; then
        echo "the rmac niri configuration is not a regular file" >&2
        return 1
    fi
    if [ -e "${rmac_shortcuts}" ] &&
        { [ ! -f "${rmac_shortcuts}" ] || [ -L "${rmac_shortcuts}" ]; }; then
        echo "the generated rmac shortcut configuration is not a regular file" >&2
        return 1
    fi
    # Clear a stale fallback before niri starts. The shortcut broker atomically
    # writes either the portal-owned empty mode or the fallback mode afterward.
    /usr/bin/install -m 0600 /dev/null "${rmac_shortcuts}" || return 1
    rmac_session_temporary=${rmac_session_config}.new.$$
    if [ -e "${rmac_session_temporary}" ] || [ -L "${rmac_session_temporary}" ]; then
        echo "the temporary rmac session configuration already exists" >&2
        return 1
    fi
    /usr/bin/install -m 0600 /dev/null "${rmac_session_temporary}" || return 1
    if ! printf '%s\n' \
        'include "config.kdl"' \
        'include "shortcuts-generated.kdl"' \
        >"${rmac_session_temporary}"; then
        echo "could not write the generated rmac session configuration" >&2
        return 1
    fi
    /usr/bin/mv -f "${rmac_session_temporary}" "${rmac_session_config}"
}

if [ "${login_mode}" = safe ]; then
    echo "rmac safe mode: an rmac component kept quitting, so this login runs" \
        "without the rmac shell. The next login starts normally." >&2
    # Safe mode retains niri and the secure lock coordinator, but intentionally
    # does not select rmac portal backends or optional shell surfaces. The rmac
    # entry point is still kept current so `rmac-session-start
    # --clear-safe-mode` can switch niri to it without logging out.
    XDG_CURRENT_DESKTOP=niri
    XDG_SESSION_DESKTOP=niri
    safe_mode=true
    if ! prepare_rmac_config; then
        echo "leaving this safe mode will need a new login" >&2
    fi
    unset NIRI_CONFIG
    /usr/bin/systemctl --user unset-environment NIRI_CONFIG \
        >/dev/null 2>&1 || :
else
    XDG_CURRENT_DESKTOP=rmac:niri
    XDG_SESSION_DESKTOP=rmac
    if ! prepare_rmac_config; then
        exit 1
    fi
    NIRI_CONFIG=${rmac_session_config}
    export NIRI_CONFIG
fi
XDG_SESSION_TYPE=wayland
if [ -x /usr/bin/gsettings ]; then
    case $(/usr/bin/gsettings get org.gnome.desktop.interface color-scheme 2>/dev/null) in
        "'prefer-dark'") RMAC_COLOR_SCHEME=dark ;;
        "'prefer-light'"|"'default'") RMAC_COLOR_SCHEME=light ;;
        *) unset RMAC_COLOR_SCHEME ;;
    esac
else
    unset RMAC_COLOR_SCHEME
fi
export XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_SESSION_TYPE
[ -z "${RMAC_COLOR_SCHEME-}" ] || export RMAC_COLOR_SCHEME

if [ -n "${NIRI_CONFIG-}" ]; then
    if ! /usr/bin/systemctl --user import-environment NIRI_CONFIG RMAC_COLOR_SCHEME; then
        echo "could not select the rmac niri configuration" >&2
        exit 1
    fi
    rmac_config_imported=true
fi

/usr/bin/niri-session &
session_pid=$!

# niri-session owns the compositor lifecycle and imports the graphical login
# environment. Do not start shell services until both its user unit and socket
# routing value are ready. The bounded wait returns to GDM on a broken session.
ready=false
attempt=0
while [ "${attempt}" -lt 300 ]; do
    if ! kill -0 "${session_pid}" 2>/dev/null; then
        wait "${session_pid}"
        status=$?
        echo "niri exited before the rmac session became ready" >&2
        if [ "${status}" -ne 0 ]; then
            exit "${status}"
        fi
        exit 1
    fi
    manager_environment=$(
        /usr/bin/systemctl --user show-environment 2>/dev/null
    ) || manager_environment=
    if /usr/bin/systemctl --user --quiet is-active niri.service &&
        printf '%s\n' "${manager_environment}" |
            /usr/bin/awk \
                -v niri_config="${NIRI_CONFIG-}" '
                $0 == "XDG_SESSION_TYPE=wayland" { wayland = 1 }
                $0 == "NIRI_CONFIG=" niri_config { config = 1 }
                index($0, "WAYLAND_DISPLAY=") == 1 && length($0) > 16 { display = 1 }
                index($0, "NIRI_SOCKET=") == 1 && length($0) > 12 { socket = 1 }
                END {
                    if (niri_config != "") {
                        exit !(wayland && config && display && socket)
                    }
                    exit !(wayland && display && socket)
                }
            '; then
            ready=true
            break
    fi
    /usr/bin/sleep 0.1
    attempt=$((attempt + 1))
done

if [ "${ready}" != true ]; then
    echo "niri did not become ready for the rmac session" >&2
    terminate_session TERM 1
fi

# niri-session imports its own compositor identity into the user manager and
# publishes the newly-created Wayland and IPC socket values there. Keep the
# package wrapper's rmac identity, but copy only those two bounded routing
# values back into this process before starting supervised shell services.
environment_value()
{
    printf '%s\n' "${manager_environment}" |
        /usr/bin/awk -v key="$1=" '
            index($0, key) == 1 {
                print substr($0, length(key) + 1)
                found = 1
                exit
            }
            END { if (!found) exit 1 }
        '
}

WAYLAND_DISPLAY=$(environment_value WAYLAND_DISPLAY) || {
    echo "niri did not publish a Wayland display" >&2
    terminate_session TERM 1
}
NIRI_SOCKET=$(environment_value NIRI_SOCKET) || {
    echo "niri did not publish its control socket" >&2
    terminate_session TERM 1
}
case ${WAYLAND_DISPLAY} in
    ''|*/*|*[!A-Za-z0-9._-]*)
        echo "niri published an invalid Wayland display" >&2
        terminate_session TERM 1
        ;;
esac
case ${NIRI_SOCKET} in
    "${XDG_RUNTIME_DIR:-/invalid}"/niri.*.sock) ;;
    *)
        echo "niri published an invalid control socket" >&2
        terminate_session TERM 1
        ;;
esac
export WAYLAND_DISPLAY NIRI_SOCKET
if DISPLAY=$(environment_value DISPLAY 2>/dev/null); then
    export DISPLAY
else
    unset DISPLAY
fi

if [ "${safe_mode}" = false ]; then
    # Ubuntu's niri package may enable Waybar for graphical-session.target.
    # rmac owns the only menu bar in its normal session; stop the third-party
    # bar without disabling it for the separately selectable niri session.
    /usr/bin/systemctl --user stop waybar.service >/dev/null 2>&1 || :
fi

if [ "${safe_mode}" = true ]; then
    set -- --system-package --safe-mode
else
    set -- --system-package
fi
if ! /usr/libexec/rmac/rmac-session-start "$@"; then
    echo "rmac session services did not start" >&2
    # The start command can fail after activating one target, so always attempt
    # a bounded namespace-only cleanup before returning to GDM.
    rmac_started=true
    terminate_session TERM 1
fi
rmac_started=true

wait "${session_pid}"
status=$?
session_pid=
stop_rmac
exit "${status}"
