{
  "title": "View Enter Full Screen toggles the Monitor window",
  "app": "system-monitor",
  "lulo_only": true,
  "steps": [
    {"observe": "opened", "facts": ["windows"]},
    {"key": "ctrl-cmd-f"},
    {"observe": "full_screen", "facts": ["windows"]},
    {"key": "ctrl-cmd-f"},
    {"observe": "returned", "facts": ["windows"]}
  ]
}
