[Unit]
Description=rmac session health supervisor
Documentation=https://github.com/rmac/rmac
After=graphical-session-pre.target

[Service]
Type=simple
ExecStart=%h/.local/libexec/rmac/rmac-session-supervisor monitor
Restart=on-failure
RestartSec=2s
StartLimitIntervalSec=60s
StartLimitBurst=3
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=rmac-session.target rmac-safe-mode.target
