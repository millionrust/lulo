{
  "title": "Calendar: Month arrow keys move the selected day",
  "app": "calendar",
  "launch": {},
  "lulo_only": true,
  "steps": [
    {"key": "cmd-3"},
    {"key": "cmd-t"},
    {"observe": "today", "facts": ["tabs", "calendar_month"]},
    {"key": "right"},
    {"observe": "next_day", "facts": ["calendar_month"]},
    {"key": "down"},
    {"observe": "next_week", "facts": ["calendar_month"]}
  ]
}
