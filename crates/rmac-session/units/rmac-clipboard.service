[Unit]
Description=rmac clipboard history
PartOf=rmac-session.target
After=rmac-session-supervisor.service
OnFailure=rmac-component-failure@%N.service
StartLimitIntervalSec=60s
StartLimitBurst=4
ConditionFileIsExecutable=%h/.local/libexec/rmac/rmac-clipboard-service

[Service]
Type=dbus
BusName=org.rmac.Clipboard1
ExecStart=%h/.local/libexec/rmac/rmac-clipboard-service
Restart=on-failure
RestartSec=1s
NoNewPrivileges=yes
PrivateTmp=yes
