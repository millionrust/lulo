+
+    /// Tell event-stream clients which screen edge a window drag is at. (Lulo OS patch.)
+    pub fn ipc_window_move_edge_changed(&mut self, id: u64, edge: Option<&'static str>) {
+        let Some(server) = &self.niri.ipc_server else {
+            return;
+        };
+
+        server.send_event(Event::WindowMoveEdgeChanged {
+            id,
+            edge: edge.map(str::to_owned),
+        });
+    }
+
+    /// Tell event-stream clients that a window drag ended, and at which edge. (Lulo OS patch.)
+    pub fn ipc_window_move_ended(&mut self, id: u64, edge: Option<&'static str>) {
+        let Some(server) = &self.niri.ipc_server else {
+            return;
+        };
+
+        server.send_event(Event::WindowMoveEnded {
+            id,
+            edge: edge.map(str::to_owned),
+        });
+    }
 }
