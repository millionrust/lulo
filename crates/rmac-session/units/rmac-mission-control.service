[Unit]
Description=rmac Mission Control, App Exposé, Spaces and hot corners
PartOf=rmac-session.target
After=rmac-session-supervisor.service
OnFailure=rmac-component-failure@%N.service
StartLimitIntervalSec=60s
StartLimitBurst=4
ConditionFileIsExecutable=%h/.local/libexec/rmac/rmac-mission-control

[Service]
Type=simple
ExecStart=%h/.local/libexec/rmac/rmac-mission-control --service
Restart=on-failure
RestartSec=1s
NoNewPrivileges=yes
PrivateTmp=yes
