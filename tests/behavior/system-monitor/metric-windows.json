{
  "title": "Window ▸ CPU Usage, CPU History and GPU History open their floating windows without crashing",
  "app": "system-monitor",
  "lulo_only": true,
  "steps": [
    {"key": "cmd-2", "settle": 1.2},
    {"observe": "cpu_usage", "facts": ["windows"]},
    {"key": "cmd-3", "settle": 1.2},
    {"observe": "cpu_history", "facts": ["windows"]},
    {"key": "cmd-4", "settle": 1.2},
    {"observe": "gpu_history", "facts": ["windows"]}
  ],
  "omit": [
    "cpu_usage.windows.front",
    "cpu_usage.windows.titles",
    "cpu_usage.windows.fullscreen",
    "cpu_history.windows.front",
    "cpu_history.windows.titles",
    "cpu_history.windows.fullscreen",
    "gpu_history.windows.front",
    "gpu_history.windows.titles",
    "gpu_history.windows.fullscreen"
  ]
}
