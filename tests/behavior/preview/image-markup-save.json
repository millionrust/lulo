{
  "title": "Preview: a rectangle drawn on a picture is saved into its pixels",
  "app": "preview",
  "lulo_only": true,
  "setup": {
    "files_base64": {
      "photo.png": ""
    }
  },
  "launch": {
    "file": "photo.png"
  },
  "steps": [
    {
      "wait": 1.5
    },
    {
      "key": "ctrl-cmd-r",
      "settle": 0.6
    },
    {
      "drag_in_window": [
        [
          260,
          230
        ],
        [
          420,
          330
        ]
      ],
      "settle": 0.5
    },
    {
      "key": "cmd-s",
      "settle": 2.0
    },
    {
      "observe": "rectangle_saved",
      "facts": [
        "image_pixels"
      ]
    }
  ]
}
