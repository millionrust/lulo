[Unit]
Description=rmac top bar
PartOf=rmac-session.target
After=rmac-session-supervisor.service
OnFailure=rmac-component-failure@%N.service
StartLimitIntervalSec=60s
StartLimitBurst=4
ConditionFileIsExecutable=%h/.local/libexec/rmac/rmac-top-bar

[Service]
Type=simple
ExecStart=%h/.local/libexec/rmac/rmac-top-bar
Restart=on-failure
RestartSec=1s
NoNewPrivileges=yes
PrivateTmp=yes
