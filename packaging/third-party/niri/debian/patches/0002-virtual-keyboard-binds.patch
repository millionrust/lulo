+    /// Lulo OS: run the configured bind a virtual keyboard's key press
+    /// matches, as `on_keyboard` does for real keyboards. Returns whether the
+    /// request was consumed (a bind ran, or this is the release of a press a
+    /// bind consumed); `false` lets smithay send it to the focused client.
+    ///
+    /// The modifier mask comes from the keyboard's own `modifiers` requests
+    /// (standard XKB indices: Shift 0, Lock 1, Control 2, Mod1/Alt 3,
+    /// Mod2/Num Lock 4, Mod4/Super 6), and the keysym from the seat's keymap,
+    /// which an on-screen keyboard shares in practice.
+    pub fn intercept_virtual_keyboard(
+        &mut self,
+        keyboard: &smithay::reexports::wayland_protocols_misc::zwp_virtual_keyboard_v1::server::zwp_virtual_keyboard_v1::ZwpVirtualKeyboardV1,
+        request: &smithay::reexports::wayland_protocols_misc::zwp_virtual_keyboard_v1::server::zwp_virtual_keyboard_v1::Request,
+    ) -> bool {
+        use smithay::reexports::wayland_protocols_misc::zwp_virtual_keyboard_v1::server::zwp_virtual_keyboard_v1::Request;
+        use smithay::reexports::wayland_server::Resource as _;
+
+        let id = keyboard.id();
+        match *request {
+            Request::Modifiers {
+                mods_depressed,
+                mods_latched,
+                mods_locked,
+                ..
+            } => {
+                self.niri
+                    .virtual_keyboard_mods
+                    .insert(id, mods_depressed | mods_latched | mods_locked);
+                false
+            }
+            Request::Key { key, state, .. } => {
+                let key_code = Keycode::from(key + 8);
+                if state != 1 {
+                    return self.niri.virtual_suppressed_keys.remove(&(id, key_code));
+                }
+                let mask = self.niri.virtual_keyboard_mods.get(&id).copied().unwrap_or(0);
+                let mods = ModifiersState {
+                    shift: mask & (1 << 0) != 0,
+                    caps_lock: mask & (1 << 1) != 0,
+                    ctrl: mask & (1 << 2) != 0,
+                    alt: mask & (1 << 3) != 0,
+                    num_lock: mask & (1 << 4) != 0,
+                    logo: mask & (1 << 6) != 0,
+                    ..ModifiersState::default()
+                };
+                let keyboard = self.niri.seat.get_keyboard().unwrap();
+                let raw = keyboard.with_xkb_state(self, |context| {
+                    let xkb = context.xkb().lock().unwrap();
+                    xkb.raw_syms_for_key_in_layout(key_code, Layout(0)).first().copied()
+                });
+                let Some(raw) = raw else {
+                    return false;
+                };
+                let mod_key = self.backend.mod_key(&self.niri.config.borrow());
+                let bind = {
+                    let config = self.niri.config.borrow();
+                    let bindings = make_binds_iter(
+                        &config,
+                        &mut self.niri.window_mru_ui,
+                        modifiers_from_state(mods),
+                    );
+                    find_configured_bind(bindings, mod_key, Trigger::Keysym(raw), mods)
+                };
+                let Some(bind) = bind else {
+                    return false;
+                };
+                if self.is_inhibiting_shortcuts() && bind.allow_inhibiting {
+                    return false;
+                }
+                self.niri.virtual_suppressed_keys.insert((id, key_code));
+                self.handle_bind(bind);
+                true
+            }
+            _ => false,
+        }
+    }
+
+    /// Lulo OS: drop a destroyed virtual keyboard's modifier and suppression
+    /// state.
+    pub fn forget_virtual_keyboard(
+        &mut self,
+        keyboard: &smithay::reexports::wayland_protocols_misc::zwp_virtual_keyboard_v1::server::zwp_virtual_keyboard_v1::ZwpVirtualKeyboardV1,
+    ) {
+        use smithay::reexports::wayland_server::Resource as _;
+
+        let id = keyboard.id();
+        self.niri.virtual_keyboard_mods.remove(&id);
+        self.niri.virtual_suppressed_keys.retain(|(owner, _)| *owner != id);
+    }
+
     pub fn handle_bind(&mut self, bind: Bind) {
         let Some(cooldown) = bind.cooldown else {
             self.do_action(bind.action, bind.allow_when_locked);
