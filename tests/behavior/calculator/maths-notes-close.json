{
  "title": "Calculator: ⌘W closes the Maths Notes window and leaves Calculator open",
  "app": "calculator",
  "launch": {},
  "lulo_only": true,
  "steps": [
    {"key": "alt-cmd-m", "settle": 1.2},
    {"observe": "notes_open", "facts": ["windows"]},
    {"key": "cmd-w", "settle": 1.2},
    {"observe": "notes_closed", "facts": ["windows"]}
  ],
  "omit": [
    "notes_open.windows.front",
    "notes_open.windows.titles",
    "notes_closed.windows.front",
    "notes_closed.windows.titles"
  ]
}
