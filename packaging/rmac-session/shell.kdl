// Package-owned rmac niri shell policy. Updated with the rmac package.

input {
    touchpad {
        tap
        // Two-finger click is a secondary click, as on a Mac trackpad, and
        // resting palms are ignored while typing.
        click-method "clickfinger"
        dwt
        // The owner's Mac has natural scrolling off (FEEL_SPEC.md §C), so the
        // touchpad must not reverse the scroll direction.
        // macOS-like tracking speed and adaptive acceleration (FEEL_SPEC.md §D.4).
        accel-profile "adaptive"
        accel-speed 0.3
    }
    keyboard {
        // macOS defaults: 225 ms initial delay, ~90 ms repeat (FEEL_SPEC.md §C).
        repeat-delay 225
        repeat-rate 11
    }
}

layout {
    gaps 6
    center-focused-column "never"
    default-column-width { proportion 0.72; }

    focus-ring {
        off
    }

    border {
        off
    }
}

// Original rmac pointer theme (FEEL_SPEC.md §D.2). Clients get the same via
// XCURSOR_THEME from the session start script.
cursor {
    xcursor-theme "rmac"
    xcursor-size 24
    // macOS hides the pointer while typing until the mouse moves again.
    hide-when-typing
}

// macOS has no middle-click selection paste; only the clipboard pastes.
clipboard {
    disable-primary
}

// The rmac menu sits in the top-left corner, so niri's overview hot corner
// must never fire there. Mission Control is opened from the keyboard and Dock.
gestures {
    hot-corners {
        off
    }
}

// Motion continuity (FEEL_SPEC.md §D.3), matching the §4.9 motion tokens.
// macOS: windows come from somewhere, work off-screen in one coordinated
// motion, and Mission Control eases rather than snaps.
animations {
    // App launch: scale up over 320 ms, ease-out.
    window-open {
        duration-ms 320
        curve "ease-out-expo"
    }
    // App quit / close: reverse over 200 ms, ease-in.
    window-close {
        duration-ms 200
        curve "cubic-bezier" 0.55 0.06 0.68 0.19
    }
    // Moving/resizing a window eases rather than jumps (§D.3).
    window-movement {
        duration-ms 300
        curve "ease-out-cubic"
    }
    window-resize {
        duration-ms 300
        curve "ease-out-cubic"
    }
    // Space switch: the whole desktop slides over 320 ms, ease-in-out.
    workspace-switch {
        duration-ms 320
        curve "cubic-bezier" 0.65 0.0 0.35 1.0
    }
    horizontal-view-movement {
        duration-ms 320
        curve "ease-out-cubic"
    }
    // Mission Control: windows fly to their slots over 350 ms.
    overview-open-close {
        duration-ms 350
        curve "cubic-bezier" 0.65 0.0 0.35 1.0
    }
    config-notification-open-close {
        duration-ms 250
        curve "ease-out-quad"
    }
    screenshot-ui-open {
        duration-ms 250
        curve "ease-out-quad"
    }
    exit-confirmation-open-close {
        duration-ms 200
        curve "ease-out-quad"
    }
}

// Named workspaces initially appear in declaration order. Keep the visible
// desktop first so a new login never starts inside the hidden parking area.
workspace "Desktop"

// niri has no native minimize, so the shell hides a window by parking it on
// this named workspace. It must be declared here for niri to resolve the name
// in a move-window-to-workspace reference; the shell excludes it from the
// Spaces bar, Mission Control, the app switcher, and Dock running counts (§2.2).
workspace "rmac-parking"

// macOS uses freely movable, overlapping application windows. Keep niri as
// the Wayland compositor, but make its normal presentation floating instead
// of exposing the scrolling-tiler layout as the product experience.
window-rule {
    open-floating true
    // macOS 27 standardized one window radius for every window; the old
    // 12/16 toolbar split is gone (FEEL_SPEC.md §B).
    geometry-corner-radius 16
    clip-to-geometry true
    focus-ring { off; }
    border { off; }
    shadow {
        on
        softness 32
        spread 0
        offset x=0 y=12
        color "#00000073"
        inactive-color "#0000004d"
    }
}

// Finder opens at its last saved size (never maximized) and lets niri clip and
// blur the translucent source-list material behind its unified toolbar.
window-rule {
    match app-id=r#"^org\.rmac\.Files$"#
    background-effect {
        xray false
        blur true
        noise 0.02
        saturation 1.25
    }
}

hotkey-overlay {
    skip-at-startup
}

screenshot-path "~/Pictures/Screenshots/Screenshot %Y-%m-%d at %H.%M.%S.png"

// Niri 26.04 owns the background sampling and GPU blur. rmac windows remain
// translucent clients, so protected or occluded desktop pixels never need to
// be copied into an application-owned texture.
blur {
    passes 3
    offset 3
    noise 0.02
    saturation 1.5
}

// Floating rmac glass samples the actual content beneath it, like macOS,
// rather than niri's cheaper wallpaper-only xray backdrop. Blur itself is
// still requested and shaped by each bounded client surface.
layer-rule {
    match namespace=r#"^rmac-(launcher|quick-settings|notification-center|app-drawer|dock-material|menu-material)(-|$)"#
    background-effect {
        xray false
    }
}

binds {
    // Preserve Super/Command letter keys for the focused application. macOS
    // uses Control+Arrow for Spaces and Control+Up for Mission Control.
    Ctrl+Left repeat=false hotkey-overlay-title="Previous Space" { focus-workspace-up; }
    Ctrl+Right repeat=false hotkey-overlay-title="Next Space" { focus-workspace-down; }
    Ctrl+Up repeat=false hotkey-overlay-title="Mission Control" { toggle-overview; }
    Mod+Ctrl+F repeat=false hotkey-overlay-title="Full Screen" { fullscreen-window; }
    Mod+Shift+3 repeat=false hotkey-overlay-title="Capture Screen" { spawn "/usr/libexec/rmac/rmac-sound" "screenshot-screen"; }
    Print repeat=false hotkey-overlay-title="Capture Screen" { spawn "/usr/libexec/rmac/rmac-sound" "screenshot-screen"; }
    XF86AudioRaiseVolume allow-when-locked=true { spawn "/usr/libexec/rmac/rmac-osd" "volume-up"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "/usr/libexec/rmac/rmac-osd" "volume-down"; }
    XF86AudioMute allow-when-locked=true { spawn "/usr/libexec/rmac/rmac-osd" "toggle-output-mute"; }
    XF86AudioMicMute allow-when-locked=true { spawn "/usr/libexec/rmac/rmac-osd" "toggle-input-mute"; }
    // Media keys (F7–F9 on a Mac keyboard) control the Now Playing player.
    XF86AudioPlay allow-when-locked=true { spawn "/usr/libexec/rmac/rmac-media" "play-pause"; }
    XF86AudioPause allow-when-locked=true { spawn "/usr/libexec/rmac/rmac-media" "pause"; }
    XF86AudioNext allow-when-locked=true { spawn "/usr/libexec/rmac/rmac-media" "next"; }
    XF86AudioPrev allow-when-locked=true { spawn "/usr/libexec/rmac/rmac-media" "previous"; }
    XF86AudioStop allow-when-locked=true { spawn "/usr/libexec/rmac/rmac-media" "stop"; }
    XF86MonBrightnessUp allow-when-locked=true { spawn "/usr/libexec/rmac/rmac-osd" "brightness-up"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "/usr/libexec/rmac/rmac-osd" "brightness-down"; }
    // ⌘Tab is the per-application rmac switcher (docs/decisions/0009). Each
    // press forwards one word to the resident service, whose overlay holds
    // the keyboard and activates the selection when ⌘ is released.
    Mod+Tab hotkey-overlay-title="Switch Applications" { spawn "/usr/libexec/rmac/rmac-app-switcher" "next"; }
    Mod+Shift+Tab hotkey-overlay-title="Switch Applications Backwards" { spawn "/usr/libexec/rmac/rmac-app-switcher" "previous"; }
}

// Super+grave keeps niri's MRU cycle restricted to the current app's
// windows, like ⌘` on the Mac. Listing binds here replaces niri's defaults,
// so its per-window Alt/Super+Tab switcher stays off.
recent-windows {
    binds {
        Mod+grave { next-window filter="app-id"; }
        Mod+Shift+grave { previous-window filter="app-id"; }
    }
}

// The ⌘Tab panel: 176 tall with a 56 pt radius, centred on the output.
layer-rule {
    match namespace=r#"^rmac-app-switcher$"#
    geometry-corner-radius 56
    shadow {
        on
        softness 40
        spread 0
        offset x=0 y=12
        color "#00000059"
    }
    background-effect {
        xray false
        blur true
        noise 0.02
        saturation 1.4
    }
}

// macOS 26-style system feedback lives beneath the menu bar on the display
// receiving keyboard focus. Niri owns the backdrop sampling and rounded blur.
// Single-card shell panels fill their surface, so the compositor blur and
// shadow take the card's own corner radius (popover 20, large surface 24).
// Control Center's surface is sized to its modules and rounded concentric
// with them (rmac_quick_settings::layout::SURFACE_RADIUS).
layer-rule {
    match namespace=r#"^rmac-quick-settings$"#
    geometry-corner-radius 44
    shadow {
        on
        softness 30
        spread 2
        offset x=0 y=10
        color "#00000055"
    }
}

layer-rule {
    match namespace=r#"^rmac-app-drawer$"#
    geometry-corner-radius 24
    shadow {
        on
        softness 30
        spread 2
        offset x=0 y=10
        color "#00000055"
    }
}

// The Dock material surface is exactly the shelf, so the compositor blur takes
// the shelf's measured radius (28.5 at tile 64, design-lab/dock.html; niri
// gets the nearest whole point). macOS draws no shadow under the Dock.
layer-rule {
    match namespace=r#"^rmac-dock-material-"#
    geometry-corner-radius 28
}

// The OSD is the Control Center Sound/Display module shown on its own:
// 292 × 64 with the module's 22 pt corner radius.
layer-rule {
    match namespace=r#"^rmac-osd-"#
    geometry-corner-radius 22
    shadow {
        on
        softness 24
        spread 2
        offset x=0 y=8
        color "#00000050"
    }
    background-effect {
        xray false
        blur true
        noise 0.025
        saturation 1.35
    }
}

// GPUI 0.2 popups are ordinary xdg-shell windows. Keep them out of niri's
// scrolling layout and give each one the intended macOS-style presentation.
window-rule {
    match app-id=r#"^org\.rmac\.Launcher$"#
    open-floating true
    default-column-width { fixed 644; }
    default-window-height { fixed 60; }
    default-floating-position x=0 y=44 relative-to="top"
    geometry-corner-radius 24
    background-effect { blur true; }
    focus-ring { off; }
    border { off; }
}

window-rule {
    match app-id=r#"^org\.rmac\.QuickSettings$"#
    open-floating true
    default-column-width { fixed 304; }
    default-window-height { fixed 360; }
    default-floating-position x=12 y=12 relative-to="top-right"
    geometry-corner-radius 20
    background-effect { blur true; }
    focus-ring { off; }
    border { off; }
}

window-rule {
    match app-id=r#"^org\.rmac\.NotificationCenter$"#
    open-floating true
    default-column-width { fixed 360; }
    default-window-height { fixed 720; }
    default-floating-position x=12 y=12 relative-to="top-right"
    geometry-corner-radius 20
    background-effect { blur true; }
    focus-ring { off; }
    border { off; }
}

window-rule {
    match app-id=r#"^org\.rmac\.AppDrawer$"#
    open-floating true
    default-column-width { fixed 760; }
    default-window-height { fixed 520; }
    geometry-corner-radius 24
    clip-to-geometry true
    background-effect { blur true; }
    focus-ring { off; }
    border { off; }
}
