{
  "title": "Mail: Message ▸ Add Sender to VIPs, then View ▸ Filter ▸ Only from VIP shows that sender's mail",
  "app": "mail",
  "launch": {},
  "lulo_only": true,
  "steps": [
    {"observe": "before", "facts": ["mail_messages"]},
    {"menu_action": "mail::ToggleSenderVip", "settle": 1},
    {"menu_action": "mail::ToggleMessageFilter", "settle": 1},
    {"menu_action": "mail::FilterUnread", "settle": 1},
    {"menu_action": "mail::FilterVip", "settle": 1},
    {"observe": "only_vip", "facts": ["mail_messages"]},
    {"menu_action": "mail::FilterVip", "settle": 1},
    {"observe": "everyone", "facts": ["mail_messages"]}
  ]
}
