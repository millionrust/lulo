{
  "title": "Undo (⌘Z) after Paste (⌘V) removes the pasted copy",
  "app": "files",
  "setup": {
    "files": {
      "report.txt": "Behaviour-suite fixture. Safe to delete.\n"
    }
  },
  "launch": {
    "reveal": "report.txt"
  },
  "steps": [
    {
      "key": "cmd-2"
    },
    {
      "key": "cmd-c"
    },
    {
      "key": "cmd-v",
      "settle": 1.5
    },
    {
      "key": "cmd-z",
      "settle": 1.2
    },
    {
      "observe": "undone",
      "facts": [
        "files"
      ]
    }
  ]
}
