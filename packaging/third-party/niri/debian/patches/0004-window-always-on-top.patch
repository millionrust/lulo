+    /// How many windows at the front of the stack stay on top (Lulo OS).
+    fn pinned_count(&self) -> usize {
+        self.tiles
+            .iter()
+            .take_while(|tile| tile.window().is_always_on_top())
+            .count()
+    }
+
+    /// Lulo OS "Always on Top": pin a window to the front of the stack, or
+    /// release it to just below the windows that stay pinned.
+    pub fn set_window_always_on_top(&mut self, id: Option<&W::Id>, on: bool) {
+        let Some(id) = id.or(self.active_window_id.as_ref()).cloned() else {
+            return;
+        };
+        let Some(idx) = self.idx_of(&id) else {
+            return;
+        };
+        if self.tiles[idx].window().is_always_on_top() == on {
+            return;
+        }
+        self.tiles[idx].window_mut().set_always_on_top(on);
+        let to = if on {
+            self.raise_window(idx, 0);
+            0
+        } else {
+            let tile = self.tiles.remove(idx);
+            let data = self.data.remove(idx);
+            let at = self.pinned_count();
+            self.tiles.insert(at, tile);
+            self.data.insert(at, data);
+            at
+        };
+        self.bring_up_descendants_of(to);
+    }
