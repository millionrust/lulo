{
  "title": "Weather: F enters and exits full screen outside search",
  "app": "weather",
  "launch": {},
  "lulo_only": true,
  "setup": {
    "config": {
      "rmac/weather.json": "{\"places\": [{\"name\": \"Athivilai\", \"region\": \"India\", \"latitude\": 13.08, \"longitude\": 80.27}], \"selected\": 0}"
