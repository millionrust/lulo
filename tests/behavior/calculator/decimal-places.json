{
  "title": "Calculator: Decimal Places rounds the display without changing the result",
  "app": "calculator",
  "launch": {},
  "lulo_only": true,
  "steps": [
    {"type": "1/3="},
    {"observe": "default", "facts": ["display"]},
    {"menu_action": "calculator::DecimalPlaces2"},
