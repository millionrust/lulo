{
  "title": "Selecting to a terminal mark highlights retained output",
  "app": "terminal",
  "lulo_only": true,
  "steps": [
    {"key": "cmd-u"},
    {"type": "printf 'marked output\\n'\n", "settle": 1.0},
    {"key": "shift-cmd-up"},
    {"observe": "selected", "facts": ["focus"]}
  ],
  "tolerance": {"selected.focus.selected_text": "present"}
}
