{
  "title": "Files: first folder tasks",
  "steps": [
    {
      "launch": "files",
      "path": "."
    },
    {
      "shot": "open-folder",
      "expect_window": "org.rmac.Files"
    },
    {
      "key": "cmd-1"
    },
    {
      "shot": "icons"
    },
    {
      "key": "cmd-2"
    },
    {
      "shot": "list"
    },
    {
      "key": "cmd-3"
    },
    {
      "shot": "columns"
    },
    {
      "key": "cmd-4"
    },
    {
      "shot": "gallery"
    },
    {
      "key": "cmd-2"
    },
    {
      "shot": "list-again"
    },
    {
      "click": "report.txt"
    },
    {
      "shot": "selected"
    },
    {
      "key": "space"
    },
    {
      "shot": "quick-look",
      "expect_window": "org.rmac.QuickLook"
    },
    {
      "key": "escape"
    },
    {
      "shot": "quick-look-closed",
      "expect_window": "org.rmac.Files",
      "expect_unmapped": [
        "org.rmac.QuickLook"
      ]
    },
    {
      "key": "return"
    },
    {
      "shot": "rename-field"
    },
    {
      "type": "renamed"
    },
    {
      "shot": "rename-typed"
    },
    {
      "key": "return"
    },
    {
      "shot": "renamed",
      "expect_files": [
        "renamed.txt",
        "second.txt"
      ],
      "expect_no_files": [
        "report.txt"
      ]
    },
    {
      "key": "cmd-shift-n"
    },
    {
      "shot": "new-folder",
      "expect_files": [
        "untitled folder"
      ]
    },
    {
      "key": "return"
    },
    {
      "shot": "folder-committed"
    },
    {
      "click": "renamed.txt"
    },
    {
      "shot": "select-to-bin"
    },
    {
      "key": "cmd-backspace"
    },
    {
      "shot": "in-bin",
      "expect_no_files": [
        "renamed.txt"
      ]
    },
    {
      "key": "cmd-z"
    },
    {
      "shot": "undo-bin",
      "expect_files": [
        "renamed.txt"
      ]
    }
  ],
  "setup": {
    "files": {
      "report.txt": "A disposable file for the parallel journey.\n",
      "second.txt": "Second item.\n"
    }
  }
}
