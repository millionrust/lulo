+/// How close to a screen edge the pointer must be for it to count, in logical pixels.
+/// The pointer is clamped to the output, so it rests at the edge itself. (Lulo OS patch.)
+const EDGE_ZONE: f64 = 2.;
+/// How far along an edge from a corner still counts as that corner. (Lulo OS patch.)
+const CORNER_ZONE: f64 = 48.;
+
+/// The edge or corner of an output of `size` that `pos` is at, as the IPC event names it.
+fn screen_edge(
+    pos: Point<f64, Logical>,
+    size: smithay::utils::Size<f64, Logical>,
+) -> Option<&'static str> {
+    let left = pos.x <= EDGE_ZONE;
+    let right = pos.x >= size.w - 1. - EDGE_ZONE;
+    let top = pos.y <= EDGE_ZONE;
+    let bottom = pos.y >= size.h - 1. - EDGE_ZONE;
+    let near_left = pos.x <= CORNER_ZONE;
+    let near_right = pos.x >= size.w - 1. - CORNER_ZONE;
+    let near_top = pos.y <= CORNER_ZONE;
+    let near_bottom = pos.y >= size.h - 1. - CORNER_ZONE;
+    Some(match () {
+        _ if (top && near_left) || (left && near_top) => "top-left",
+        _ if (top && near_right) || (right && near_top) => "top-right",
+        _ if (bottom && near_left) || (left && near_bottom) => "bottom-left",
+        _ if (bottom && near_right) || (right && near_bottom) => "bottom-right",
+        _ if left => "left",
+        _ if right => "right",
+        _ if top => "top",
+        _ if bottom => "bottom",
+        _ => return None,
+    })
+}
+
+/// The IPC id of `window`, if it is mapped.
+fn window_id(data: &State, window: &Window) -> Option<u64> {
+    data.niri.layout.workspaces().find_map(|(_, _, ws)| {
+        ws.windows()
+            .find(|mapped| mapped.window == *window)
+            .map(|mapped| mapped.id().get())
+    })
+}
