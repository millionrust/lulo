{
  "title": "Text Editor: ⌘W closes the window right after the Save sheet saved it",
  "app": "text-editor",
  "launch": {},
  "lulo_only": true,
  "steps": [
    {
      "type": "Hello"
    },
    {
      "key": "cmd-s",
      "settle": 1.5
    },
    {
      "type": "CloseAfterSave"
    },
    {
      "key": "return",
      "settle": 1.5
    },
    {
      "observe": "saved",
      "facts": [
        "saved_documents",
        "focus"
      ]
    },
    {
      "key": "cmd-w",
      "settle": 1.5
    },
    {
      "observe": "closed",
      "facts": [
        "windows"
      ]
    }
  ]
}
