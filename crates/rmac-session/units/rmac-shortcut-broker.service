[Unit]
Description=rmac global shortcut broker
PartOf=rmac-session.target
Wants=xdg-desktop-portal.service
After=rmac-session-supervisor.service xdg-desktop-portal.service rmac-launcher.service
OnFailure=rmac-component-failure@%N.service
StartLimitIntervalSec=60s
StartLimitBurst=4
ConditionPathIsExecutable=%h/.local/libexec/rmac/rmac-shortcut-broker

[Service]
Type=simple
ExecStart=%h/.local/libexec/rmac/rmac-shortcut-broker
Restart=on-failure
RestartSec=1s
NoNewPrivileges=yes
PrivateTmp=yes
