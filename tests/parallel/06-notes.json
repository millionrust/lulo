{
  "title": "Notes: create a disposable note",
  "steps": [
    {
      "launch": "notes"
    },
    {
      "shot": "notes-open",
      "expect_window": "org.rmac.Notes"
    },
    {
      "key": "cmd-n"
    },
    {
      "shot": "new-note"
    },
    {
      "type": "Parallel journey note"
    },
    {
      "shot": "note-typed",
      "expect_text": {
        "label": "Title",
        "equals": "Parallel journey note"
      }
    },
    {
      "key": "return"
    },
    {
      "shot": "note-newline",
      "expect_change": false
    },
    {
      "type": "- [ ] Buy milk"
    },
    {
      "shot": "checklist-typed",
      "expect_text": {
        "label": "Body",
        "contains": "- [ ] Buy milk"
      }
    },
    {
      "click": "More"
    },
    {
      "shot": "more-menu-open"
    },
    {
      "click": "Show Markdown Preview"
    },
    {
      "shot": "checklist-preview"
    },
    {
      "click": "Not done"
    },
    {
      "shot": "checklist-ticked"
    }
  ],
  "mac": "unsafe",
  "mac_reason": "Notes can sync new content into the owner’s iCloud account."
}
