[org.gnome.login-screen]
logo=''

[org.gnome.desktop.interface]
clock-format='12h'
clock-show-weekday=true
accent-color='blue'
font-name='Inter 11'

[org.gnome.desktop.background]
picture-uri='file:///usr/share/rmac/greeter/rmac-aurora.svg'
picture-uri-dark='file:///usr/share/rmac/greeter/rmac-aurora.svg'
picture-options='zoom'
primary-color='#10162f'
secondary-color='#3949ab'
