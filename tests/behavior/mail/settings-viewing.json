{
  "title": "Mail: Settings ▸ Viewing toggles unread bold and dark message backgrounds",
  "app": "mail",
  "launch": {},
  "lulo_only": true,
  "steps": [
    {"key": "cmd-,", "settle": 1.0},
    {"select": "Viewing", "settle": 0.6},
    {"observe": "defaults", "facts": ["settings_controls"]},
    {"select": "Display unread messages with bold font", "settle": 0.5},
    {"select": "Use dark backgrounds for messages", "settle": 0.5},
    {"observe": "toggled", "facts": ["settings_controls"]}
  ]
}
