{
  "title": "Mail: View ▸ Filter keeps unread mail, then unread or flagged mail",
  "app": "mail",
  "launch": {},
  "lulo_only": true,
  "steps": [
    {"observe": "before", "facts": ["mail_messages"]},
    {"menu_action": "mail::ToggleMessageFilter"},
    {"observe": "unread", "facts": ["mail_messages"]},
    {"menu_action": "mail::FilterFlagged"},
    {"observe": "unread_or_flagged", "facts": ["mail_messages"]},
    {"menu_action": "mail::ToggleMessageFilter"},
    {"observe": "all", "facts": ["mail_messages"]}
  ]
}
