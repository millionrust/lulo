{
  "title": "Mail: Message ▸ Flag ▸ a colour flags the message, Clear Flag removes it",
  "app": "mail",
  "launch": {},
  "lulo_only": true,
  "steps": [
    {"observe": "before", "facts": ["mail_messages"]},
    {"key": "down", "settle": 1},
    {"menu_action": "mail::FlagPurple"},
    {"observe": "purple", "facts": ["mail_messages"]},
    {"menu_action": "mail::FlagGreen"},
    {"observe": "green", "facts": ["mail_messages"]},
    {"menu_action": "mail::ClearFlag"},
    {"observe": "cleared", "facts": ["mail_messages"]}
  ]
}
