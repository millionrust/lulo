{
  "title": "Save (⌘S) on an Untitled document opens the attached Save sheet with the name selected",
  "app": "text-editor",
  "launch": {},
  "steps": [
    {"type": "Hello"},
    {"key": "cmd-s", "settle": 1.5},
    {"wait": 4},
    {"observe": "panel", "facts": ["focus", "dialog"]},
    {"key": "escape", "settle": 1.0},
    {"observe": "cancelled", "facts": ["dialog", "windows"]}
  ],
  "tolerance": {"panel.dialog.title": "ignore", "panel.focus.label": "ignore"},
  "omit": ["panel.dialog.texts"]
}
