{
  "title": "Login Password Change… opens the Change Password sheet and Escape cancels it",
  "app": "settings",
  "lulo_only": true,
  "launch": {"pane": "login-password"},
  "steps": [
    {"wait": 1.5},
    {"select": "Change…", "settle": 0.5},
    {"observe": "sheet", "facts": ["dialog"]},
    {"key": "escape", "settle": 0.5},
    {"observe": "cancelled", "facts": ["dialog"]}
  ]
}
