# Lulo OS boot splash (ADR 0029): the lockup centred on night blue, three
# softly pulsing seeds under it, and a password prompt for encrypted disks.

Window.SetBackgroundTopColor(0.063, 0.086, 0.184);
Window.SetBackgroundBottomColor(0.063, 0.086, 0.184);

screen_w = Window.GetWidth();
screen_h = Window.GetHeight();
screen_x = Window.GetX();
screen_y = Window.GetY();

logo.image = Image("lockup.png");
logo.sprite = Sprite(logo.image);
logo.x = screen_x + screen_w / 2 - logo.image.GetWidth() / 2;
logo.y = screen_y + screen_h / 2 - logo.image.GetHeight() / 2;
logo.sprite.SetPosition(logo.x, logo.y, 10);

dot_image = Image("dot.png");
for (i = 0; i < 3; i++) {
    dots[i] = Sprite(dot_image);
    dots[i].SetPosition(screen_x + screen_w / 2 + (i - 1) * 24 - dot_image.GetWidth() / 2,
                        logo.y + logo.image.GetHeight() + 56, 10);
    dots[i].SetOpacity(0.3);
}

tick = 0;
fun refresh_callback() {
    tick++;
    for (i = 0; i < 3; i++) {
        phase = Math.Sin((tick / 12) - i * 0.9);
        dots[i].SetOpacity(0.35 + 0.65 * Math.Max(phase, 0));
    }
}
Plymouth.SetRefreshFunction(refresh_callback);

# --- Password prompt (LUKS) ---------------------------------------------
prompt_sprite = Sprite();
bullets_sprite = Sprite();

fun display_password_callback(prompt, bullets) {
    for (i = 0; i < 3; i++) dots[i].SetOpacity(0);
    prompt_image = Image.Text(prompt, 0.85, 0.87, 0.95);
    prompt_sprite.SetImage(prompt_image);
    prompt_sprite.SetPosition(screen_x + screen_w / 2 - prompt_image.GetWidth() / 2,
                              logo.y + logo.image.GetHeight() + 40, 20);
    text = "";
    for (i = 0; i < bullets; i++) text += "•";
    if (text == "") text = " ";
    bullets_image = Image.Text(text, 1, 1, 1);
    bullets_sprite.SetImage(bullets_image);
    bullets_sprite.SetPosition(screen_x + screen_w / 2 - bullets_image.GetWidth() / 2,
                               logo.y + logo.image.GetHeight() + 72, 20);
    prompt_sprite.SetOpacity(1);
    bullets_sprite.SetOpacity(1);
}

fun display_normal_callback() {
    prompt_sprite.SetOpacity(0);
    bullets_sprite.SetOpacity(0);
}

Plymouth.SetDisplayPasswordFunction(display_password_callback);
Plymouth.SetDisplayNormalFunction(display_normal_callback);

# --- Messages (for example "Please remove the installation medium") ------
message_sprite = Sprite();
fun message_callback(text) {
    message_image = Image.Text(text, 0.75, 0.78, 0.9);
    message_sprite.SetImage(message_image);
    message_sprite.SetPosition(screen_x + screen_w / 2 - message_image.GetWidth() / 2,
                               screen_y + screen_h * 0.85, 30);
}
Plymouth.SetMessageFunction(message_callback);
