{
  "title": "Notes: Find and Replace edits the selected note",
  "app": "notes",
  "launch": {},
  "lulo_only": true,
  "steps": [
    {"wait": 2},
    {"key": "cmd-n", "settle": 1},
    {"type": "Parity note"},
    {"observe": "new_note_title", "facts": ["focus"]},
    {"key": "tab"},
    {"type": "alpha beta alpha"},
    {"observe": "note_body", "facts": ["focus"]},
    {"key": "shift-cmd-f"},
    {"type": "alpha"},
    {"observe": "find_query", "facts": ["focus"]},
    {"key": "tab"},
    {"type": "gamma"},
    {"observe": "replacement", "facts": ["focus"]},
    {"select": "Replace"},
    {"select": "Done"},
    {"observe": "replaced_body", "facts": ["focus"]}
  ]
}
