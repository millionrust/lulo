{
  "title": "Copying two selected files and pasting adds both copies",
  "app": "files",
  "setup": {
    "files": {
      "a.txt": "Behaviour-suite fixture. Safe to delete.\n",
      "b.txt": "Behaviour-suite fixture. Safe to delete.\n"
    }
  },
  "launch": {
    "folder": "."
  },
  "steps": [
    {
      "key": "cmd-2"
    },
    {
      "select": "a.txt"
    },
    {
      "select": "b.txt",
      "modifiers": [
        "shift"
      ],
      "settle": 0.6
    },
    {
      "key": "cmd-c"
    },
    {
      "key": "cmd-v",
      "settle": 1.5
    },
    {
      "observe": "pasted",
      "facts": [
        "files"
      ]
    }
  ]
}
