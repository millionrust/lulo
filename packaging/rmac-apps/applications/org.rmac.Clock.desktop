[Desktop Entry]
Version=1.5
Type=Application
Name=Clock
Name[hi]=घड़ी
GenericName=Clock
GenericName[hi]=घड़ी
Comment=World clock, alarms, stopwatch and timers
Comment[hi]=विश्व घड़ी, अलार्म, स्टॉपवॉच और टाइमर
Keywords=clock;alarm;timer;stopwatch;time;world;
Keywords[hi]=घड़ी;अलार्म;टाइमर;स्टॉपवॉच;समय;विश्व;
TryExec=/usr/bin/rmac-clock
Exec=/usr/bin/rmac-clock
Icon=org.rmac.Clock
Terminal=false
Categories=Utility;Clock;
StartupWMClass=org.rmac.Clock
