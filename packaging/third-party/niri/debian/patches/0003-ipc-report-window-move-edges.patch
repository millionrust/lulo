+    WindowMoveEdgeChanged {
+        /// Id of the window being dragged.
+        id: u64,
+        /// The edge or corner under the pointer, if any.
+        edge: Option<String>,
+    },
+    /// A window drag ended, with the edge or corner the pointer was at when it was released.
+    ///
+    /// niri leaves the window where it was dropped; a desktop shell may tile it to `edge`.
+    /// Transient. (Lulo OS patch.)
+    WindowMoveEnded {
+        /// Id of the window that was dragged.
+        id: u64,
+        /// The edge or corner under the pointer at release, if any.
+        edge: Option<String>,
+    },
 }
 
