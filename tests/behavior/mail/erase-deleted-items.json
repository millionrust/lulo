{
  "title": "Mail: Mailbox ▸ Erase Deleted Items removes deleted mail for good, so ⌘Z no longer brings it back",
  "app": "mail",
  "launch": {},
  "lulo_only": true,
  "steps": [
    {"observe": "before", "facts": ["mail_messages"]},
    {"key": "down", "settle": 1},
    {"observe": "selected", "facts": ["mail_messages"]},
    {"key": "backspace", "settle": 1},
    {"observe": "deleted", "facts": ["mail_messages"]},
    {"menu_action": "mail::EraseDeletedItemsNow"},
    {"key": "cmd-z", "settle": 1},
    {"observe": "erased", "facts": ["mail_messages"]}
  ]
}
