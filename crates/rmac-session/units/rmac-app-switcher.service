[Unit]
Description=rmac application switcher
PartOf=rmac-session.target
After=rmac-session-supervisor.service
OnFailure=rmac-component-failure@%N.service
StartLimitIntervalSec=60s
StartLimitBurst=4
ConditionFileIsExecutable=%h/.local/libexec/rmac/rmac-app-switcher

[Service]
Type=simple
ExecStart=%h/.local/libexec/rmac/rmac-app-switcher --service
Restart=on-failure
RestartSec=1s
NoNewPrivileges=yes
PrivateTmp=yes
