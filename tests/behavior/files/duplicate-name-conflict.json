{
  "title": "Duplicating a file twice numbers the second copy “name copy 2”",
  "app": "files",
  "setup": {
    "files": {
      "report.txt": "Behaviour-suite fixture. Safe to delete.\n"
    }
  },
  "launch": {
    "reveal": "report.txt"
  },
  "steps": [
    {
      "key": "cmd-2"
    },
    {
      "key": "cmd-d",
      "settle": 1.2
    },
    {
      "select": "report.txt"
    },
    {
      "key": "cmd-d",
      "settle": 1.2
    },
    {
      "observe": "duplicated_twice",
      "facts": [
        "files",
        "selection"
      ]
    }
  ]
}
