#!/bin/sh
set -e
# Keep an opted-in Mac keyboard configuration (/etc/keyd/rmac.conf, see
# docs/decisions/0017-mac-keyboard.md) in step with this version's bindings.
# Nothing is created here: the feature stays off until the user turns on
# System Settings > Keyboard > "Use Mac shortcuts in all apps".

helper=/usr/libexec/rmac/rmac-mac-keyboard

case "$1" in
configure)
    if [ -f /etc/keyd/rmac.conf ] && [ -x "$helper" ]; then
        changed=$("$helper" regenerate 2>/dev/null) || changed=""
        if [ -n "$changed" ] && command -v systemctl >/dev/null 2>&1; then
            systemctl try-restart keyd.service >/dev/null 2>&1 || true
        fi
    fi
    ;;
esac

exit 0
