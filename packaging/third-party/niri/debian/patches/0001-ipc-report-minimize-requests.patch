+    /// Tell event-stream clients that a window asked to be minimized. (Lulo OS patch.)
+    pub fn ipc_window_minimize_requested(&mut self, id: u64) {
+        let Some(server) = &self.niri.ipc_server else {
+            return;
+        };
+
+        server.send_event(Event::WindowMinimizeRequested { id });
+    }
