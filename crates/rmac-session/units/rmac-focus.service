[Unit]
Description=rmac Focus policy authority
PartOf=rmac-session.target
After=rmac-session-supervisor.service
OnFailure=rmac-component-failure@%N.service
StartLimitIntervalSec=60s
StartLimitBurst=4
ConditionFileIsExecutable=%h/.local/libexec/rmac/rmac-focus-service

[Service]
Type=dbus
BusName=org.rmac.Focus1
ExecStart=%h/.local/libexec/rmac/rmac-focus-service
Restart=on-failure
RestartSec=1s
NoNewPrivileges=yes
PrivateTmp=yes
