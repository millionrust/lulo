[Unit]
Description=rmac Quick Settings
PartOf=rmac-session.target
After=rmac-session-supervisor.service rmac-focus.service
Before=rmac-shortcut-broker.service
OnFailure=rmac-component-failure@%N.service
StartLimitIntervalSec=60s
StartLimitBurst=4
ConditionFileIsExecutable=%h/.local/libexec/rmac/rmac-quick-settings

[Service]
Type=notify
NotifyAccess=all
ExecStart=%h/.local/libexec/rmac/rmac-quick-settings
Restart=on-failure
RestartSec=1s
NoNewPrivileges=yes
PrivateTmp=yes
