{
  "title": "Mail: Mailbox ▸ New Mailbox…, Rename Mailbox… and Delete Mailbox… add, rename and remove a mailbox in the sidebar",
  "app": "mail",
  "launch": {},
  "lulo_only": true,
  "steps": [
    {"observe": "before", "facts": ["mail_mailboxes"]},
    {"menu_action": "mail::NewMailbox"},
    {"type": "Travel", "settle": 1},
    {"key": "enter", "settle": 1},
    {"observe": "created", "facts": ["mail_mailboxes"]},
    {"menu_action": "mail::RenameMailbox"},
    {"type": "Trips", "settle": 1},
    {"key": "enter", "settle": 1},
    {"observe": "renamed", "facts": ["mail_mailboxes"]},
    {"menu_action": "mail::DeleteMailbox"},
    {"key": "enter", "settle": 1},
    {"observe": "deleted", "facts": ["mail_mailboxes"]}
  ]
}
