[Unit]
Description=rmac launcher
PartOf=rmac-session.target
After=rmac-session-supervisor.service
OnFailure=rmac-component-failure@%N.service
StartLimitIntervalSec=0
ConditionFileIsExecutable=%h/.local/libexec/rmac/rmac-launcher

[Service]
Type=notify
NotifyAccess=all
ExecStart=%h/.local/libexec/rmac/rmac-launcher
# The dispatcher starts this unit on first use. The process exits after its
# configurable idle interval with no open window.
Restart=no
NoNewPrivileges=yes
PrivateTmp=yes
