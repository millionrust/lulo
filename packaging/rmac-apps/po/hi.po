msgstr "मूल टर्मिनल में कमांड लाइन का उपयोग करें"

msgid "shell;prompt;command;console;"
msgstr "शेल;प्रॉम्प्ट;कमांड;कंसोल;"

msgid "Notes"
msgstr "नोट्स"

