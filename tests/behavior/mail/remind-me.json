{
  "title": "Mail: Message ▸ Remind Me ▸ Remind Me Later… brings a read message back unread once its time has come",
  "app": "mail",
  "launch": {},
  "lulo_only": true,
  "steps": [
    {"observe": "before", "facts": ["mail_messages"]},
    {"key": "down", "settle": 1},
    {"observe": "read", "facts": ["mail_messages"]},
    {"menu_action": "mail::RemindLater"},
    {"type": "1 Jan 2020 09:00", "settle": 1},
    {"key": "enter", "settle": 2},
    {"observe": "reminded", "facts": ["mail_messages"]}
  ]
}
