{
  "title": "View Selected Processes keeps only the selected process",
  "app": "system-monitor",
  "lulo_only": true,
  "steps": [
    {"key": "alt-cmd-f"},
    {"type": "rmac-system-monitor"},
    {"key": "cmd-g"},
    {"observe": "selected", "facts": ["selection"]},
    {"key": "cmd-a"},
    {"key": "BackSpace"},
    {"menu_action": "activity_monitor::ShowSelectedProcesses"},
    {"observe": "filtered", "facts": ["monitor_rows", "selection"]}
  ],
  "tolerance": {
    "selected.selection.items": "count",
    "filtered.selection.items": "count"
  }
}
