// Package-owned rmac niri shell policy. Updated with the rmac package.

input {
    touchpad {
        tap
        natural-scroll
    }
}

layout {
    gaps 6
    center-focused-column "never"
    default-column-width { proportion 0.72; }

    focus-ring {
        off
    }

    border {
        off
    }
}

// macOS uses freely movable, overlapping application windows. Keep niri as
// the Wayland compositor, but make its normal presentation floating instead
// of exposing the scrolling-tiler layout as the product experience.
window-rule {
    open-floating true
    geometry-corner-radius 12
    clip-to-geometry true
    focus-ring { off; }
    border { off; }
}

// Finder uses the measured macOS document-window curve and lets niri clip and
// blur the translucent source-list material behind its unified toolbar.
window-rule {
    match app-id=r#"^org\.rmac\.Files$"#
    open-maximized true
    geometry-corner-radius 12
    clip-to-geometry true
    shadow {
        on
        softness 28
        spread 2
        offset x=0 y=8
        color "#00000050"
    }
    background-effect {
        xray false
        blur true
        noise 0.02
        saturation 1.25
    }
}

hotkey-overlay {
    skip-at-startup
}

screenshot-path "~/Pictures/Screenshots/Screenshot %Y-%m-%d at %H.%M.%S.png"

// Niri 26.04 owns the background sampling and GPU blur. rmac windows remain
// translucent clients, so protected or occluded desktop pixels never need to
// be copied into an application-owned texture.
blur {
    passes 3
    offset 3
    noise 0.02
    saturation 1.5
}

binds {
    // Preserve Super/Command letter keys for the focused application. macOS
    // uses Control+Arrow for Spaces and Control+Up for Mission Control.
    Ctrl+Left repeat=false hotkey-overlay-title="Previous Space" { focus-workspace-up; }
    Ctrl+Right repeat=false hotkey-overlay-title="Next Space" { focus-workspace-down; }
    Ctrl+Up repeat=false hotkey-overlay-title="Mission Control" { toggle-overview; }
    Mod+Ctrl+F repeat=false hotkey-overlay-title="Full Screen" { fullscreen-window; }
    XF86AudioRaiseVolume allow-when-locked=true { spawn "/usr/libexec/rmac/rmac-osd" "volume-up"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "/usr/libexec/rmac/rmac-osd" "volume-down"; }
    XF86AudioMute allow-when-locked=true { spawn "/usr/libexec/rmac/rmac-osd" "toggle-output-mute"; }
    XF86AudioMicMute allow-when-locked=true { spawn "/usr/libexec/rmac/rmac-osd" "toggle-input-mute"; }
    XF86MonBrightnessUp allow-when-locked=true { spawn "/usr/libexec/rmac/rmac-osd" "brightness-up"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "/usr/libexec/rmac/rmac-osd" "brightness-down"; }
}

// niri 26.04 owns the compositor-level MRU UI. Super+Tab follows the macOS
// recent-window flow; Super+grave restricts the cycle to the current app.
recent-windows {
    binds {
        Mod+Tab { next-window; }
        Mod+grave { next-window filter="app-id"; }
    }
}

// macOS 26-style system feedback lives beneath the menu bar on the display
// receiving keyboard focus. Niri owns the backdrop sampling and rounded blur.
layer-rule {
    match namespace=r#"^rmac-osd-"#
    geometry-corner-radius 28
    shadow {
        on
        softness 24
        spread 2
        offset x=0 y=8
        color "#00000050"
    }
    background-effect {
        xray false
        blur true
        noise 0.025
        saturation 1.35
    }
}

// GPUI 0.2 popups are ordinary xdg-shell windows. Keep them out of niri's
// scrolling layout and give each one the intended macOS-style presentation.
window-rule {
    match app-id=r#"^org\.rmac\.Launcher$"#
    open-floating true
    default-column-width { fixed 644; }
    default-window-height { fixed 60; }
    default-floating-position x=0 y=44 relative-to="top"
    geometry-corner-radius 24
    background-effect { blur true; }
    focus-ring { off; }
    border { off; }
}

window-rule {
    match app-id=r#"^org\.rmac\.QuickSettings$"#
    open-floating true
    default-column-width { fixed 304; }
    default-window-height { fixed 360; }
    default-floating-position x=12 y=12 relative-to="top-right"
    geometry-corner-radius 20
    background-effect { blur true; }
    focus-ring { off; }
    border { off; }
}

window-rule {
    match app-id=r#"^org\.rmac\.NotificationCenter$"#
    open-floating true
    default-column-width { fixed 360; }
    default-window-height { fixed 720; }
    default-floating-position x=12 y=12 relative-to="top-right"
    geometry-corner-radius 20
    background-effect { blur true; }
    focus-ring { off; }
    border { off; }
}

window-rule {
    match app-id=r#"^org\.rmac\.AppDrawer$"#
    open-floating true
    default-column-width { fixed 760; }
    default-window-height { fixed 520; }
    geometry-corner-radius 24
    clip-to-geometry true
    background-effect { blur true; }
    focus-ring { off; }
    border { off; }
}
