{
  "title": "Notes stays running after its last window closes and composes from File menu",
  "app": "notes",
  "lulo_only": true,
  "launch": {},
  "steps": [
    {"key": "cmd-w", "settle": 1.2},
    {"observe": "windowless", "facts": ["windows"]},
    {"menu_action": "notes::ComposeNote", "settle": 1.2},
    {"observe": "reopened", "facts": ["windows"]}
  ],
  "omit": ["reopened.windows.front", "reopened.windows.titles"]
}
