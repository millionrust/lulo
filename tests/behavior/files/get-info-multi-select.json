{
  "title": "Get Info (⌘I) on several selected files opens an Info window for each item",
  "app": "files",
  "setup": {
    "files": {
      "a.txt": "Behaviour-suite fixture. Safe to delete.\n",
      "b.txt": "Behaviour-suite fixture. Safe to delete.\n"
    }
  },
  "launch": {
    "folder": "."
  },
  "steps": [
    {
      "key": "cmd-2"
    },
    {
      "select": "a.txt"
    },
    {
      "select": "b.txt",
      "modifiers": [
        "shift"
      ],
      "settle": 0.6
    },
    {
      "key": "cmd-i",
      "settle": 1.2
    },
    {
      "observe": "info",
      "facts": [
        "windows"
      ]
    }
  ],
  "omit": [
    "info.windows.titles"
  ]
}
