[Unit]
Description=rmac notification center
PartOf=rmac-session.target
After=rmac-session-supervisor.service
Before=xdg-desktop-portal.service
OnFailure=rmac-component-failure@%N.service
StartLimitIntervalSec=60s
StartLimitBurst=4
ConditionPathIsExecutable=%h/.local/libexec/rmac/rmac-notification-center

[Service]
Type=dbus
BusName=org.freedesktop.impl.portal.desktop.rmac
ExecStart=%h/.local/libexec/rmac/rmac-notification-center
Restart=on-failure
RestartSec=1s
NoNewPrivileges=yes
PrivateTmp=yes
