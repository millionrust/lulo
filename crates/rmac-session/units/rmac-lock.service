[Unit]
Description=rmac secure session locker
Documentation=https://github.com/rmac/rmac
BindsTo=graphical-session.target
After=graphical-session.target
OnFailure=rmac-lock-fallback.service
StartLimitIntervalSec=30s
StartLimitBurst=5
ConditionPathExists=/etc/pam.d/rmac-lock

[Service]
Type=notify
NotifyAccess=all
ExecStart=%h/.local/libexec/rmac/rmac-lock-provider
TimeoutStartSec=15s
WatchdogSec=10s
WatchdogSignal=SIGKILL
Restart=on-failure
RestartSec=1s
KillMode=control-group
