{
  "title": "Find (⌘F) focuses the find field; typing searches",
  "app": "text-editor",
  "launch": {},
  "steps": [
    {"type": "hello world hello"},
    {"key": "cmd-f"},
    {"observe": "find", "facts": ["focus"]},
    {"type": "hello"},
    {"observe": "typed", "facts": ["focus"]}
