{
  "title": "List disclosure expands a folder inline and keyboard arrows move through its children",
  "app": "files",
  "setup": {
    "files": {
      "Projects/": null,
      "Projects/plan.txt": "Plan\n",
      "report.txt": "Report\n"
    }
  },
  "launch": {
    "reveal": "Projects"
  },
  "steps": [
    {
      "key": "cmd-2"
    },
    {
      "key": "cmd-right"
    },
    {
      "key": "down"
    },
    {
      "observe": "child",
      "facts": [
        "selection"
      ]
    },
    {
      "key": "cmd-d",
      "settle": 1.5
    },
    {
      "observe": "duplicated_child",
      "facts": [
        "files"
      ]
    },
    {
      "select": "Projects"
    },
    {
      "key": "cmd-left"
    },
    {
      "key": "down"
    },
    {
      "observe": "collapsed",
      "facts": [
        "selection"
      ]
    }
  ]
}
