{
  "title": "Mail: typing in search filters the message list by sender",
  "app": "mail",
  "launch": {},
  "lulo_only": true,
  "steps": [
    {"observe": "before", "facts": ["mail_messages"]},
    {"key": "cmd-f", "settle": 0.5},
    {"type": "Anna"},
    {"wait": 1},
    {"observe": "filtered", "facts": ["mail_messages"]}
  ]
}
