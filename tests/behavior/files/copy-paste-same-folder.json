{
  "title": "Copy (⌘C) then Paste (⌘V) in the same folder makes a copy named “name copy.ext”",
  "app": "files",
  "setup": {
    "files": {
      "report.txt": "Behaviour-suite fixture. Safe to delete.\n"
    }
  },
  "launch": {
    "reveal": "report.txt"
  },
  "steps": [
    {
      "key": "cmd-2"
    },
    {
      "key": "cmd-c"
    },
    {
      "key": "cmd-v",
      "settle": 1.5
    },
    {
      "observe": "pasted",
      "facts": [
        "files",
        "selection"
      ]
    }
  ]
}
