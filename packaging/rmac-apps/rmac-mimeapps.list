# SPDX-License-Identifier: MIT
# Defaults for XDG_CURRENT_DESKTOP=rmac (installed as
# /usr/share/applications/rmac-mimeapps.list). A user's own choice in
# ~/.config/mimeapps.list still wins. Archives open with Archive Utility,
# which expands them next to themselves, as on macOS; audio and video open
# in Media Player, as they open in QuickTime Player; PDFs and pictures open
# in Preview and plain text in Text Editor, as they open in Preview and
# TextEdit. Without these lines a double-click picked whichever installed
# app happened to claim the type first.
[Default Applications]
application/zip=org.rmac.ArchiveUtility.desktop
application/x-tar=org.rmac.ArchiveUtility.desktop
application/x-compressed-tar=org.rmac.ArchiveUtility.desktop
application/x-bzip2-compressed-tar=org.rmac.ArchiveUtility.desktop
application/x-bzip-compressed-tar=org.rmac.ArchiveUtility.desktop
application/x-xz-compressed-tar=org.rmac.ArchiveUtility.desktop
application/gzip=org.rmac.ArchiveUtility.desktop
application/x-bzip2=org.rmac.ArchiveUtility.desktop
application/x-bzip=org.rmac.ArchiveUtility.desktop
application/x-xz=org.rmac.ArchiveUtility.desktop
audio/mpeg=org.rmac.Player.desktop
audio/mp4=org.rmac.Player.desktop
audio/x-m4a=org.rmac.Player.desktop
audio/aac=org.rmac.Player.desktop
audio/flac=org.rmac.Player.desktop
audio/x-flac=org.rmac.Player.desktop
audio/ogg=org.rmac.Player.desktop
audio/opus=org.rmac.Player.desktop
audio/x-vorbis+ogg=org.rmac.Player.desktop
audio/x-wav=org.rmac.Player.desktop
audio/wav=org.rmac.Player.desktop
video/mp4=org.rmac.Player.desktop
video/x-m4v=org.rmac.Player.desktop
video/quicktime=org.rmac.Player.desktop
video/x-matroska=org.rmac.Player.desktop
video/webm=org.rmac.Player.desktop
video/x-msvideo=org.rmac.Player.desktop
video/mpeg=org.rmac.Player.desktop
video/ogg=org.rmac.Player.desktop
application/pdf=org.rmac.Preview.desktop
image/png=org.rmac.Preview.desktop
image/jpeg=org.rmac.Preview.desktop
image/gif=org.rmac.Preview.desktop
image/webp=org.rmac.Preview.desktop
image/bmp=org.rmac.Preview.desktop
image/tiff=org.rmac.Preview.desktop
text/plain=org.rmac.TextEditor.desktop
text/markdown=org.rmac.TextEditor.desktop
text/x-markdown=org.rmac.TextEditor.desktop
text/rtf=org.rmac.TextEditor.desktop
application/rtf=org.rmac.TextEditor.desktop
