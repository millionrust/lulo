#!/usr/bin/python3
"""rmac-update-check: the daily Lulo OS update check.

Shipped by the rmac-session package as /usr/libexec/rmac/rmac-update-check
and run once a day (and once shortly after login) by the
rmac-update-check.timer / rmac-update-check.service user units. It runs once
and exits; nothing stays resident.

Everything goes through PackageKit's own client library (PackageKitGlib via
GObject introspection) and the org.freedesktop.Notifications D-Bus service.
No command-line output is parsed.

The person's choices come from System Settings > General > Software Update >
Automatic Updates, stored in $XDG_CONFIG_HOME/rmac/software-update.conf
(`download-updates`, `install-lulo-os`, `install-security`, all on by
default, like the Mac's three switches).

1. Refresh the package metadata and read the available updates as
   structured PackageKit packages. Blocked updates are ignored. Checking
   always happens, as on macOS 26.
2. The updates split by exact package name and PackageKit info:
   Lulo OS's own packages (rmac-apps, rmac-session, rmac-archive-keyring,
   niri, xwayland-satellite), security updates (SECURITY or CRITICAL), and
   everything else. The automatic set is the Lulo OS updates when
   `install-lulo-os` is on, plus the security updates when
   `install-security` is on.
3. With `download-updates` off nothing is downloaded or scheduled. With it
   on, the updates outside the automatic set are downloaded first (a
   trusted-only, download-only UpdatePackages, so System Settings can
   install them quickly later), then the automatic set is prepared as a
   PackageKit offline update: a download-only UpdatePackages for exactly
   those package IDs -- last, because PackageKit records the latest
   download-only transaction as the prepared update -- and an offline-update
   trigger with the reboot action. pk-offline-update installs them from
   system-update.target on the next restart. A caching download never runs
   while an offline update is already scheduled and the automatic set is
   empty, so it cannot replace an update System Settings prepared.
   PackageKit does not ask for authorization for download-only
   transactions, and Ubuntu's polkit policy allows the trigger for the
   active user, so no password prompt is involved. This program never
   requests interaction; if PackageKit refuses anyway, the updates fall back
   to the "open System Settings" notification.
4. The status file $XDG_STATE_HOME/rmac/software-update-status
   (`updates=<N>`, `restart-required=<0|1>`) tells the menu bar how many
   update items System Settings shows.
5. At most one desktop notification per run says what is ready and how
   many other updates wait for review in System Settings > Software Update.

Failures (PackageKit unavailable, metadata refresh, download, trigger) print
one bounded line to stderr, which lands in the user journal, and the program
exits non-zero so `systemctl --user status rmac-update-check` shows them. A
missing notification service is reported but not fatal.

Turn both the nudge and the automatic preparation off with
`systemctl --user disable --now rmac-update-check.timer`.
"""

import os
import re
import stat
import sys
import tempfile

LULO_PACKAGES = frozenset(
    (
        "rmac-apps",
        "rmac-session",
        "rmac-archive-keyring",
        "niri",
        "xwayland-satellite",
    )
)

APP_NAME = "Software Update"
ICON = "software-update-available"
NOTIFICATION_TIMEOUT_MS = 25_000

# System Settings > General > Software Update > Automatic Updates.
SETTINGS_RELATIVE = ("rmac", "software-update.conf")
SETTINGS_KEYS = ("download-updates", "install-lulo-os", "install-security")
MAX_SETTINGS_BYTES = 4096
STATUS_RELATIVE = ("rmac", "software-update-status")

EXIT_OK = 0
EXIT_FAILED = 1
EXIT_UNAVAILABLE = 2

# PackageKitGlib reports a failed transaction as a pk-client-error-quark
# GError whose code is 0xff plus the PkErrorEnum value
# (lib/packagekit-glib2/pk-client.c, pk_client_signal_finished).
CLIENT_ERROR_DOMAIN = "pk-client-error-quark"
OFFLINE_ERROR_DOMAIN = "pk-offline-error-quark"
TRANSACTION_ERROR_BASE = 0xFF

CLIENT_ERROR_NAMES = (
    "FAILED",
    "FAILED_AUTH",
    "NO_TID",
    "ALREADY_TID",
    "ROLE_UNKNOWN",
    "CANNOT_START_DAEMON",
    "INVALID_INPUT",
    "INVALID_FILE",
    "NOT_SUPPORTED",
    "DECLINED_SIMULATION",
    "DECLINED_INTERACTION",
)
OFFLINE_ERROR_NAMES = ("FAILED", "INVALID_VALUE", "NO_DATA")

_SAFE_TOKEN = re.compile(r"[^a-z0-9._:-]+")
MAX_ERROR_LINE = 200


class StageError(Exception):
    """A PackageKit step failed; carries only a stable, privacy-safe class."""

    def __init__(self, stage, error_class, authorization=False):
        super().__init__(f"{stage}: {error_class}")
        self.stage = stage
        self.error_class = error_class
        self.authorization = authorization


def _token(text):
    token = _SAFE_TOKEN.sub("-", str(text).lower()).strip("-")
    return token[:80] or "unknown"


def _enum_name(enum_type, names, code):
    for name in names:
        value = getattr(enum_type, name, None)
        if value is not None and int(value) == code:
            return name.lower().replace("_", "-")
    return None


def classify_error(Pk, error):
    """Return (class, is_authorization_failure) without any message text.

    GError messages can carry repository URLs, package names or paths; the
    journal line keeps to the stable domain/code classification instead.
    """
    domain = str(getattr(error, "domain", "") or "")
    code = int(getattr(error, "code", 0) or 0)
    if domain == CLIENT_ERROR_DOMAIN:
        if code >= TRANSACTION_ERROR_BASE:
            transaction_code = code - TRANSACTION_ERROR_BASE
            try:
                name = Pk.error_enum_to_string(transaction_code)
            except Exception:  # an unknown enum value is still classifiable
                name = None
            authorization = transaction_code == int(Pk.ErrorEnum.NOT_AUTHORIZED)
            return _token(name or f"error-{transaction_code}"), authorization
        name = _enum_name(Pk.ClientError, CLIENT_ERROR_NAMES, code)
        authorization = code in (
            int(Pk.ClientError.FAILED_AUTH),
            int(Pk.ClientError.DECLINED_INTERACTION),
        )
        return _token(name or f"client-{code}"), authorization
    if domain == OFFLINE_ERROR_DOMAIN:
        name = _enum_name(Pk.OfflineError, OFFLINE_ERROR_NAMES, code)
        return _token(f"offline-{name or code}"), False
    return _token(f"{domain or 'error'}-{code}"), False


def report(stage, error_class):
    line = f"rmac-update-check: {stage} failed: {error_class}"
    print(line[:MAX_ERROR_LINE], file=sys.stderr, flush=True)


def _progress(*_args):
    """PackageKit progress callback; the timer run has no UI to update."""


def _call(Pk, GLib, stage, function, *arguments):
    """Run one synchronous PackageKit transaction and require success."""
    try:
        results = function(*arguments, None, _progress, None)
    except GLib.Error as error:
        error_class, authorization = classify_error(Pk, error)
        raise StageError(stage, error_class, authorization) from None
    if results is None:
        raise StageError(stage, "no-results")
    exit_code = int(results.get_exit_code())
    if exit_code != int(Pk.ExitEnum.SUCCESS):
        try:
            name = Pk.exit_enum_to_string(exit_code)
        except Exception:
            name = None
        raise StageError(stage, _token(f"exit-{name or exit_code}"))
    return results


def bitfield(*values):
    """pk_bitfield_value() is a C macro, so it is not introspectable."""
    field = 0
    for value in values:
        field |= 1 << int(value)
    return field


def prepared_ids(Pk, GLib):
    """IDs PackageKit already downloaded for an offline update, or empty."""
    try:
        return frozenset(Pk.offline_get_prepared_ids() or ())
    except GLib.Error:
        # NO_DATA ("No offline updates have been prepared") or an unreadable
        # prepared-update file: prepare again from scratch.
        return frozenset()


def prepare_offline_update(Pk, GLib, client, package_ids):
    """Download exactly `package_ids` and schedule them for the next restart.

    Returns True when this run downloaded or triggered something, False when
    PackageKit already had the same update prepared and scheduled.
    """
    wanted = frozenset(package_ids)
    reboot = int(Pk.OfflineAction.REBOOT)
    if prepared_ids(Pk, GLib) == wanted:
        try:
            action = int(Pk.offline_get_action())
        except GLib.Error:
            action = None
        if action == reboot:
            return False
    else:
        flags = bitfield(
            Pk.TransactionFlagEnum.ONLY_TRUSTED,
            Pk.TransactionFlagEnum.ONLY_DOWNLOAD,
        )
        _call(Pk, GLib, "download", client.update_packages, flags, sorted(wanted))

    try:
        triggered = Pk.offline_trigger(Pk.OfflineAction.REBOOT, None)
    except GLib.Error as error:
        error_class, authorization = classify_error(Pk, error)
        raise StageError("trigger", error_class, authorization) from None
    if not triggered:
        raise StageError("trigger", "refused")
    return True


def _plural(count, singular, plural):
    return singular if count == 1 else plural


def notification_text(lulo_ready, review_count, review_is_other, security_ready=False):
    """Summary and body for this run, or None when there is nothing to say."""
    sentences = []
    if lulo_ready:
        sentences.append(
            "Lulo OS updates are ready — they will be installed the next "
            "time you restart."
        )
    elif security_ready:
        sentences.append(
            "Security updates are ready — they will be installed the next "
            "time you restart."
        )
    if review_count:
        noun = "other update" if review_is_other else "update"
        nouns = "other updates" if review_is_other else "updates"
        verb = _plural(review_count, "is", "are")
        sentences.append(
            f"{review_count} {_plural(review_count, noun, nouns)} {verb} "
            "available — open System Settings to review and install them."
        )
    if not sentences:
        return None
    if lulo_ready:
        summary = "Lulo OS update ready"
    elif security_ready:
        summary = "Updates ready"
    else:
        summary = "Updates available"
    return summary, " ".join(sentences)


def _base_directory(variable, fallback):
    """An XDG base directory: absolute $variable, else $HOME/<fallback>."""
    value = os.environ.get(variable, "")
    if value and os.path.isabs(value):
        return value
    home = os.environ.get("HOME", "")
    if not home or not os.path.isabs(home):
        return None
    return os.path.join(home, fallback)


def parse_settings(text):
    """The three Automatic Updates switches; anything unreadable is on.

    `key=true|false` lines, `#` comments. Unknown keys are ignored and a
    malformed value keeps that switch's default (on), like the Mac.
    """
    settings = {key: True for key in SETTINGS_KEYS}
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        key, separator, value = line.partition("=")
        key = key.strip()
        value = value.strip()
        if not separator or key not in settings:
            continue
        if value == "true":
            settings[key] = True
        elif value == "false":
            settings[key] = False
    return settings


def load_settings():
    """Read the settings file without following links; defaults on any error."""
    base = _base_directory("XDG_CONFIG_HOME", ".config")
    if base is None:
        return parse_settings("")
    path = os.path.join(base, *SETTINGS_RELATIVE)
    try:
        descriptor = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except OSError:
        return parse_settings("")
    try:
        with os.fdopen(descriptor, "rb") as file:
            if not stat.S_ISREG(os.fstat(file.fileno()).st_mode):
                return parse_settings("")
            raw = file.read(MAX_SETTINGS_BYTES + 1)
    except OSError:
        return parse_settings("")
    if len(raw) > MAX_SETTINGS_BYTES:
        return parse_settings("")
    try:
        return parse_settings(raw.decode("utf-8"))
    except UnicodeDecodeError:
        return parse_settings("")


def status_text(update_items, restart_required):
    return (
        "version=1\n"
        f"updates={int(update_items)}\n"
        f"restart-required={1 if restart_required else 0}\n"
    )


def write_status(update_items, restart_required):
    """Atomically replace the menu bar's status file; failures are reported."""
    base = _base_directory("XDG_STATE_HOME", os.path.join(".local", "state"))
    if base is None:
        print("rmac-update-check: status not written: no-home", file=sys.stderr, flush=True)
        return
    directory = os.path.join(base, SETTINGS_RELATIVE[0])
    temporary = None
    try:
        os.makedirs(directory, mode=0o700, exist_ok=True)
        descriptor, temporary = tempfile.mkstemp(
            prefix=".software-update-status.", dir=directory
        )
        with os.fdopen(descriptor, "w", encoding="utf-8") as file:
            os.fchmod(file.fileno(), 0o600)
            file.write(status_text(update_items, restart_required))
            file.flush()
            os.fsync(file.fileno())
        os.replace(temporary, os.path.join(directory, STATUS_RELATIVE[1]))
        temporary = None
    except OSError as error:
        print(
            f"rmac-update-check: status not written: {_token(type(error).__name__)}",
            file=sys.stderr,
            flush=True,
        )
    finally:
        if temporary is not None:
            try:
                os.unlink(temporary)
            except OSError:
                pass


def offline_reboot_pending(Pk, GLib):
    """True when an offline update is already scheduled for the next restart."""
    try:
        return int(Pk.offline_get_action()) == int(Pk.OfflineAction.REBOOT)
    except GLib.Error:
        return False


def notify(Gio, GLib, summary, body):
    """Send one notification; a missing notification service is not fatal."""
    try:
        bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        bus.call_sync(
            "org.freedesktop.Notifications",
            "/org/freedesktop/Notifications",
            "org.freedesktop.Notifications",
            "Notify",
            GLib.Variant(
                "(susssasa{sv}i)",
                (APP_NAME, 0, ICON, summary, body, [], {}, -1),
            ),
            GLib.VariantType.new("(u)"),
            Gio.DBusCallFlags.NONE,
            NOTIFICATION_TIMEOUT_MS,
            None,
        )
    except GLib.Error as error:
        domain = _token(getattr(error, "domain", "error"))
        print(
            f"rmac-update-check: notification not shown: {domain}-"
            f"{int(getattr(error, 'code', 0) or 0)}",
            file=sys.stderr,
            flush=True,
        )


def _security_infos(Pk):
    values = set()
    for name in ("SECURITY", "CRITICAL"):
        value = getattr(Pk.InfoEnum, name, None)
        if value is not None:
            values.add(int(value))
    return values


def _authorization_hint(error):
    if error.authorization:
        print(
            "rmac-update-check: PackageKit asked for authorization; "
            "install from System Settings > Software Update",
            file=sys.stderr,
            flush=True,
        )


def run(Pk, Gio, GLib):
    settings = load_settings()
    try:
        client = Pk.Client.new()
        client.set_interactive(False)
        client.set_background(True)
    except GLib.Error as error:
        report("packagekit", classify_error(Pk, error)[0])
        return EXIT_FAILED

    try:
        _call(Pk, GLib, "refresh", client.refresh_cache, False)
        results = _call(
            Pk,
            GLib,
            "get-updates",
            client.get_updates,
            bitfield(Pk.FilterEnum.NONE),
        )
    except StageError as error:
        report(error.stage, error.error_class)
        return EXIT_FAILED

    blocked = int(Pk.InfoEnum.BLOCKED)
    security = _security_infos(Pk)
    lulo_ids = set()
    security_ids = set()
    other_ids = set()
    for package in results.get_package_array() or ():
        info = int(package.get_info())
        if info == blocked:
            continue
        package_id = package.get_id()
        if package.get_name() in LULO_PACKAGES:
            lulo_ids.add(package_id)
        elif info in security:
            security_ids.add(package_id)
        else:
            other_ids.add(package_id)
    installable = lulo_ids | security_ids | other_ids

    auto_set = set()
    if settings["download-updates"]:
        if settings["install-lulo-os"]:
            auto_set |= lulo_ids
        if settings["install-security"]:
            auto_set |= security_ids

    status = EXIT_OK
    ready = False
    reboot_pending = False
    if settings["download-updates"] and installable:
        reboot_pending = offline_reboot_pending(Pk, GLib)
        # An update System Settings scheduled (Update Now) stays scheduled:
        # its still-offered packages join the automatic set, because a new
        # download-only transaction replaces PackageKit's prepared list.
        scheduled = prepared_ids(Pk, GLib) if reboot_pending else frozenset()
        keep = scheduled & installable
        already = bool(auto_set) and reboot_pending and auto_set <= scheduled
        cache_ids = installable - auto_set
        # PackageKit records the latest download-only transaction as the
        # prepared update, so a caching download must come first and may
        # never replace an update that is already scheduled.
        if cache_ids and not already and (auto_set or not reboot_pending):
            try:
                _call(
                    Pk,
                    GLib,
                    "download",
                    client.update_packages,
                    bitfield(
                        Pk.TransactionFlagEnum.ONLY_TRUSTED,
                        Pk.TransactionFlagEnum.ONLY_DOWNLOAD,
                    ),
                    sorted(cache_ids),
                )
            except StageError as error:
                report(error.stage, error.error_class)
                _authorization_hint(error)
                status = EXIT_FAILED
        if auto_set:
            try:
                if not already:
                    prepare_offline_update(Pk, GLib, client, auto_set | keep)
                ready = True
                reboot_pending = True
            except StageError as error:
                report(error.stage, error.error_class)
                _authorization_hint(error)
                # The automatic path did not happen: offer these updates for
                # review in System Settings instead, and still fail the unit.
                status = EXIT_FAILED

    lulo_ready = ready and bool(lulo_ids & auto_set)
    security_ready = ready and bool(security_ids & auto_set)
    review_count = len(installable - auto_set) if ready else len(installable)
    update_items = (1 if lulo_ids else 0) + (1 if security_ids or other_ids else 0)
    write_status(update_items, reboot_pending)

    text = notification_text(
        lulo_ready, review_count, review_is_other=ready, security_ready=security_ready
    )
    if text is not None:
        notify(Gio, GLib, *text)
    return status


def main():
    try:
        import gi

        gi.require_version("PackageKitGlib", "1.0")
        gi.require_version("Gio", "2.0")
        gi.require_version("GLib", "2.0")
        from gi.repository import Gio, GLib
        from gi.repository import PackageKitGlib as Pk
    except (ImportError, ValueError):
        print(
            "rmac-update-check: packagekit client library unavailable "
            "(gir1.2-packagekitglib-1.0, python3-gi)",
            file=sys.stderr,
            flush=True,
        )
        return EXIT_UNAVAILABLE
    return run(Pk, Gio, GLib)


if __name__ == "__main__":
    sys.exit(main())
