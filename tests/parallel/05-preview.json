{
  "title": "Preview: PDF and image",
  "steps": [
    {
      "launch": "preview",
      "file": "sample.pdf"
    },
    {
      "shot": "pdf",
      "expect_window": "org.rmac.Preview"
    },
    {
      "key": "cmd-+"
    },
    {
      "shot": "pdf-zoom-in"
    },
    {
      "key": "cmd--"
    },
    {
      "shot": "pdf-zoom-out"
    },
    {
      "key": "cmd-w"
    },
    {
      "shot": "pdf-closed",
      "expect_unmapped": [
        "org.rmac.Preview"
      ]
    },
    {
      "launch": "preview",
      "file": "sample.png"
    },
    {
      "shot": "image",
      "expect_window": "org.rmac.Preview"
    },
    {
      "key": "cmd-+"
    },
    {
      "shot": "image-zoom-in"
    },
    {
      "key": "cmd-w"
    },
    {
      "shot": "image-closed",
      "expect_unmapped": [
        "org.rmac.Preview"
      ]
    }
  ],
  "setup": {
    "fixtures": [
      "sample.pdf",
      "sample.png"
    ]
  }
}
