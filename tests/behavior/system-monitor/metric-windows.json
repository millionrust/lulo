{
  "title": "Window ▸ CPU Usage opens its floating window without crashing System Monitor, and ⌘W closes it",
  "app": "system-monitor",
  "lulo_only": true,
  "steps": [
    {"key": "cmd-2", "settle": 1.2},
    {"observe": "cpu_usage", "facts": ["windows"]},
    {"key": "cmd-w", "settle": 1.2},
    {"observe": "closed", "facts": ["windows"]}
  ],
  "omit": [
    "cpu_usage.windows.front",
    "cpu_usage.windows.titles",
    "cpu_usage.windows.fullscreen",
    "closed.windows.front",
    "closed.windows.titles",
    "closed.windows.fullscreen"
  ]
}
