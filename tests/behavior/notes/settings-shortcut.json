{
  "title": "Notes: Settings shortcut opens one settings window and closes it",
  "app": "notes",
  "launch": {},
  "lulo_only": true,
  "steps": [
    {
      "key": "cmd-,",
      "settle": 1.5
    },
    {
      "observe": "opened",
      "facts": [
        "windows"
      ]
    },
    {
      "observe": "grouped",
      "facts": [
        "settings_controls"
      ]
    },
    {
      "select": "Group notes by date",
      "settle": 1.0
    },
    {
      "observe": "ungrouped",
      "facts": [
        "settings_controls"
      ]
    },
    {
      "select": "Group notes by date",
      "settle": 1.0
    },
    {
      "observe": "regrouped",
      "facts": [
        "settings_controls"
      ]
    },
    {
      "key": "cmd-,",
      "settle": 0.5
    },
    {
      "observe": "singleton",
      "facts": [
        "windows"
      ]
    },
    {
      "key": "cmd-w",
      "settle": 0.5
    },
    {
      "observe": "closed",
      "facts": [
        "windows"
      ]
    }
  ]
}
