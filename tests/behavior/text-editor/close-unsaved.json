{
  "title": "Closing an edited Untitled document shows the Save sheet; Escape and ⌘. cancel",
  "app": "text-editor",
  "launch": {},
  "steps": [
    {"type": "Hello"},
    {"key": "cmd-w", "settle": 1.2},
    {"observe": "asked", "facts": ["dialog"]},
    {"key": "escape"},
    {"observe": "cancelled", "facts": ["dialog", "windows"]},
    {"key": "cmd-w", "settle": 1.2},
    {"key": "cmd-."},
    {"observe": "cancelled-period", "facts": ["dialog", "windows"]}
  ]
}
